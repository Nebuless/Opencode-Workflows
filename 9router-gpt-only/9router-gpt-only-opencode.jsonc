{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent@4.19.4",
    "@nebulesstech/opencode-9router@0.1.1"
  ],
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",
      "options": {
        "baseURL": "{env:NINE_ROUTER_BASE_URL}",
        "apiKey": "{env:NINE_ROUTER_API_KEY}"
      }
    }
  },
  "model": "9router/cx/gpt-5.6-terra",
  "agent": {
    "explorer": {
      "description": "Fast explorer subagent for codebase exploration",
      "mode": "subagent",
      "model": "9router/cx/gpt-5.6-luna",
      "variant": "high"
    },
    "plan-consultant": {
      "description": "Planning consultant for implementation analysis",
      "mode": "subagent",
      "model": "9router/cx/gpt-6-astra",
      "variant": "high"
    },
    "plan-reviewer": {
      "description": "Plan reviewer for implementation readiness",
      "mode": "subagent",
      "model": "9router/cx/gpt-6-astra",
      "variant": "high"
    },
    "adversarial-reviewer": {
      "description": "Adversarial reviewer for implementation risks",
      "mode": "subagent",
      "model": "9router/cx/gpt-5.6-sol",
      "variant": "xhigh"
    },
    "implementer": {
      "description": "Implementation subagent for scoped coding tasks",
      "mode": "subagent",
      "model": "9router/cx/gpt-5.6-luna",
      "variant": "high"
    }
  }
}

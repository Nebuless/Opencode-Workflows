        "model": "9router/cx/gpt-5.6-terra",
        "variant": "high"
      },
      "quick": {
        "model": "9router/cx/gpt-5.6-luna",
        "variant": "medium"
      },
      "unspecified-low": {
        "model": "9router/cx/gpt-5.6-luna",
        "variant": "medium"
      },
      "unspecified-high": {
        "model": "9router/cx/gpt-5.6-terra",
        "variant": "high"
      },
      "writing": {
        "model": "9router/cx/gpt-5.6-luna",
        "variant": "xhigh"
      }
    }
  },
